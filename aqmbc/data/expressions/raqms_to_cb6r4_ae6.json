[
    {"name": "PRES", "expression": "pdash[:] * 100.", "units": "Pa"},
    {"name": "TEMP", "expression": "ttheta[:] * (PRES[:] / 100000.)**(.286)", "units": "K"},
    {"name": "AIRMOLDEN", "expression": "PRES[:] / 8.3144621 / TEMP", "units": "moles/m**3"},
    {"name": "PAR", "expression": "(0.4 * ic2h6[:] + ipar[:] + iolet[:] + iolei[:] + iaone[:] + ipropar[:]) * 1e6", "units": "ppmV"},
    {"name": "MSA", "expression": "imsa[:] * 96. * 1e6 * AIRMOLDEN", "units": "micrograms/m**3"},
    {"name": "DMS", "expression": "idms[:] * 1e6", "units": "ppmV"},
    {"name": "MGLY", "expression": "imgly[:] * 1e6", "units": "ppmV"},
    {"name": "CO", "expression": "ico[:] * 1e6", "units": "ppmV"},
    {"name": "ETH", "expression": "ieth[:] * 1e6", "units": "ppmV"},
    {"name": "O3", "expression": "o3vmr[:] * 1e6", "units": "ppmV"},
    {"name": "HOCL", "expression": "ihocl[:] * 1e6", "units": "ppmV"},
    {"name": "NO2", "expression": "ino2[:] * 1e6", "units": "ppmV"},
    {"name": "NO3", "expression": "ino3[:] * 1e6", "units": "ppmV"},
    {"name": "ROOH", "expression": "(irooh[:] + iethooh[:]) * 1e6", "units": "ppmV"},
    {"name": "N2O5", "expression": "in2o5[:] * 1e6", "units": "ppmV"},
    {"name": "OLE", "expression": "(iolei[:] + iolet[:]) * 1e6", "units": "ppmV"},
    {"name": "NO", "expression": "no[:] * 1e6", "units": "ppmV"},
    {"name": "HO2", "expression": "ho2[:] * 1e6", "units": "ppmV"},
    {"name": "PAN", "expression": "ipan[:] * 1e6", "units": "ppmV"},
    {"name": "MEOH", "expression": "ich3oh[:] * 1e6", "units": "ppmV"},
    {"name": "CH4", "expression": "ich4[:] * 1e6", "units": "ppmV"},
    {"name": "MEPX", "expression": "ich3ooh[:] * 1e6", "units": "ppmV"},
    {"name": "OLE2", "expression": "iolei[:] * 1e6", "units": "ppmV"},
    {"name": "MACR", "expression": "imacr[:] * 1e6", "units": "ppmV"},
    {"name": "FORM", "expression": "ich2o[:] * 1e6", "units": "ppmV"},
    {"name": "OLE1", "expression": "iolet[:] * 1e6", "units": "ppmV"},
    {"name": "PANX", "expression": "impan[:] * 1e6", "units": "ppmV"},
    {"name": "ALD2", "expression": "iald2[:] * 1e6", "units": "ppmV"},
    {"name": "HNO3", "expression": "ihno3t[:] * 1e6", "units": "ppmV"},
    {"name": "ISOP", "expression": "iisop[:] * 1e6", "units": "ppmV"},
    {"name": "SO2", "expression": "iso2[:] * 1e6", "units": "ppmV"},
    {"name": "NH3", "expression": "inh3[:] * 1e6", "units": "ppmV"},
    {"name": "ISPD", "expression": "iisoprd[:] * 1e6", "units": "ppmV"},
    {"name": "HCL", "expression": "ihcl[:] * 1e6", "units": "ppmV"},
    {"name": "H2O2", "expression": "ih2o2[:] * 1e6", "units": "ppmV"},
    {"name": "OH", "expression": "oh[:] * 1e6", "units": "ppmV"},
    {"name": "NTR", "expression": "ionit[:] * 1e6", "units": "ppmV"},
    {"name": "CL2", "expression": "icl2[:] * 1e6", "units": "ppmV"},
    {"name": "PNA", "expression": "ihno4[:] * 1e6", "units": "ppmV"},
    {"name": "ANO3I", "expression": "0.01 * ino3aer[:] * 62. * 1e6 * AIRMOLDEN", "units": "micrograms/m**3"},
    {"name": "ANO3J", "expression": "0.99 * ino3aer[:] * 62. * 1e6 * AIRMOLDEN", "units": "micrograms/m**3"},
    {"name": "AECI", "expression": "0.001 *(ibc1[:] + ibc2[:]) * 12.0 * 1e6 * AIRMOLDEN", "units": "micrograms/m**3"},
    {"name": "AECJ", "expression": "0.999 * (ibc1[:] + ibc2[:]) * 12.0 * 1e6 * AIRMOLDEN", "units": "micrograms/m**3"},
    {"name": "ASO4J", "expression": "0.99 * iso4aer[:] * 96. * 1e6 * AIRMOLDEN", "units": "micrograms/m**3"},
    {"name": "ASO4I", "expression": "0.01 * iso4aer[:] * 96. * 1e6 * AIRMOLDEN", "units": "micrograms/m**3"},
    {"name": "ANH4J", "expression": "0.99 * inh4aer[:] * 18. * 1e6 * AIRMOLDEN", "units": "micrograms/m**3"},
    {"name": "ANH4I", "expression": "0.01 * inh4aer[:] * 18. * 1e6 * AIRMOLDEN", "units": "micrograms/m**3"},
    {"name": "APOCJ", "expression": "0.999 * (ioc1[:] + ioc2[:]) * 12.0 * 1e6 * AIRMOLDEN", "units": "micrograms/m**3"},
    {"name": "APOCI", "expression": "0.001 * (ioc1[:] + ioc2[:]) * 12.0 * 1e6 * AIRMOLDEN", "units": "micrograms/m**3"},
    {"name": "AOTHRJ", "expression": "(idu1[:] + 0.14 * (iss1[:] + iss2[:])) * 1e6 * AIRMOLDEN", "units": "micrograms/m**3"},
    {"name": "ACORS", "expression": "0.14 * (iss3[:] + iss4[:]) * 1e6 * AIRMOLDEN", "units": "micrograms/m**3"},
    {"name": "ASOIL", "expression": "(idu4[:] + idu5[:]) * 1e6 * AIRMOLDEN", "units": "micrograms/m**3"},
    {"name": "ANAJ", "expression": "0.31 * (iss1[:] + iss2[:]) * 1e6 * AIRMOLDEN", "units": "micrograms/m**3"},
    {"name": "ANAK", "expression": "0.31 * (iss3[:] + iss4[:]) * 1e6 * AIRMOLDEN", "units": "micrograms/m**3"},
    {"name": "ACLJ", "expression": "0.55 * (iss1[:] + iss2[:]) * 1e6 * AIRMOLDEN", "units": "micrograms/m**3"}
]
