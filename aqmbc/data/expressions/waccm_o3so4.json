[
    {"name": "ZH", "expression": "Z3", "units": "masl", "comment": "geopotential meters above sea level"},
    {"name": "DRYMOLDENS", "expression": "M_dens / 6.0221367e23 * 1e6 * (1 - Q)", "units": "mol/m**3"},
    {"name": "DRYMASSDENS", "expression": "DRYMOLDENS * 0.0289628", "units": "kg/m**3"},
    {"name": "O3", "expression": "(1.0 * O3) * 1e6", "units": "ppmV"},
    {"name": "ASO4I", "expression": "(0.30208 * so4_a2) * DRYMASSDENS * 1e9", "units": "micrograms/m**3"},
    {"name": "ASO4J", "expression": "(0.30208 * so4_a1) * DRYMASSDENS * 1e9", "units": "micrograms/m**3"}
]
