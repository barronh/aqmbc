[
    {"name": "PRES", "expression": "Met_PMIDDRY[:] * 100", "units": "Pa"},
    {"name": "AIRMOLDEN", "expression": "Met_PMIDDRY[:] * 100 / 8.3144621 / Met_T[:]", "units": "mole/m3"},
    {"name": "O3", "expression": "(O3[:]) * 1e6", "units": "ppmV"},
    {"name": "ASO4I", "expression": "(0.01 * SO4[:] * 0.096) * AIRMOLDEN * 1e9", "units": "micrograms/m**3"},
    {"name": "ASO4J", "expression": "(0.99 * SO4[:] * 0.096) * AIRMOLDEN * 1e9", "units": "micrograms/m**3"}
]
